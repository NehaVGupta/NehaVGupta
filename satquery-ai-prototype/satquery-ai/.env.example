# Backend --------------------------------------------------------------------
SATQUERY_DATA_DIR=./demo/outputs        # where uploaded images & analysis records are stored
SATQUERY_DEMO_DIR=./demo/datasets       # synthetic demo dataset location
SATQUERY_MAX_UPLOAD_MB=50
SATQUERY_MAX_DIM=1600                   # longest side an uploaded image is downscaled to
SATQUERY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
STORAGE_BACKEND=local                   # local | s3  (s3 is a planned adapter, see docs/architecture.md)

# Engine selection — "demo" (default) uses classical-CV prototype engines.
# Set to a real adapter name (e.g. yolo) only after installing requirements-ml.txt
# and implementing the adapter in backend/app/engines/adapters.py.
SATQUERY_DETECTOR=demo
SATQUERY_SEGMENTER=demo
SATQUERY_CHANGE_DETECTOR=demo

REDIS_URL=                              # e.g. redis://localhost:6379/0 — blank = in-memory cache fallback

# Frontend ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
